# ── LLM y embeddings (Gemini) ── la key de TU APP, no el login de claude
GOOGLE_API_KEY=PEGA_TU_KEY
LLM_PROVIDER=gemini            # gemini | fake
MODEL_GUARD=gemini-3.5-flash-lite
MODEL_PLANNER=gemini-3.8-flash
MODEL_RESEARCHER=gemini-3.8-flash
MODEL_ANALYST=gemini-4-argon
MODEL_VERIFIER=gemini-4-argon
MODEL_FIGURES=gemini-4-argon
MODEL_JUDGE=gemini-4-argon
MODEL_CATALOG=gemini-3.5-flash-lite
THINKING_PLANNER=medium
THINKING_RESEARCHER=low
THINKING_ANALYST=medium
EMBED_PROVIDER=gemini2         # gemini2 (1536) | gemini1 (768) | bge-m3 (1024) | fake
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=1536
EMBED_CONCURRENCY=6

# ── Indexación ──
DATA_DIR=~/data
WORK_DIR=~/reto2_work
INDEX_DIR=~/reto2_index        # en Cloud Run: /app/bundle/index
TIER=1                         # 1 determinista | 2 añade páginas visuales con LLM
VISUAL_MAX_PAGES=60
VISUAL_BUDGET_MIN=10
LLM_CONCURRENCY=8

# ── Retrieval y agentes ──
RETRIEVAL_MODE=mcp             # mcp | direct
MCP_URL=http://localhost:8000/mcp
RERANK=none                    # none | fastembed
RUNNER_MODE=fake               # fake hasta C3; después real
GRAPH_MODE=full                # full | simple (plan B)

# ── API y despliegue ──
PORT=8000
RATE_LIMIT_PER_MIN=20
CORS_ORIGINS=http://localhost:3000
PHOENIX_ENABLED=false
GCP_PROJECT=PEGA_TU_PROYECTO
GCP_REGION=us-central1
SERVICE_NAME=banorte-ir-agent